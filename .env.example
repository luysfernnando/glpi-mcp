# GLPI instance URL (no trailing slash)
GLPI_URL=https://glpi.example.com

# GLPI API credentials (create in GLPI: Setup > General > API)
GLPI_APP_TOKEN=your_app_token_here
GLPI_USER_TOKEN=your_user_token_here

# GLPI version: 10 or 11 (controls the REST API path prefix)
GLPI_VERSION=10

# Verify TLS certificate (set to false for self-signed intranet certs)
GLPI_VERIFY_TLS=false

# Label language: fr or en
GLPI_LANG=fr
